# Copy to .env.staging.local (ignored). Fill only after project identity approval.
# Node runner needs these exported in its environment; it does not load app defaults.
LEKKA_TEST_ENVIRONMENT=staging
LEKKA_STAGING_PROJECT_REF=
LEKKA_STAGING_CONFIRM_PROJECT_REF=
LEKKA_STAGING_URL=
LEKKA_STAGING_PUBLISHABLE_KEY=

# Expo staging build; both references must identify the same approved project.
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_STAGING_PROJECT_REF=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
